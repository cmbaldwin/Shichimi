<% content_for :title, "Today · Shichimi" %>
<% week = @stats.week; goal = @stats.weekly_goal_progress; today = current_user.today; left = goal[:goal] - goal[:done_days] %>
<h1><%= @greeting %>, <%= current_user.display_name %></h1>

<% if @workout %>
  <% f = @workout.workout_format %>
  <section class="card today-card stack" data-format="<%= @workout.format %>">
    <p class="muted today-kicker"><%= @done_today ? "Done for today ✓ · Up next" : "Today's workout" %></p>
    <h2><%= @workout.name %></h2>
    <p class="muted"><%= f.spice %> <%= heat_marks f.heat %> · <span class="num"><%= mmss @workout.total_seconds %></span> · <%= f.work %>s on, <%= f.rest %>s off · <%= level_label @workout.level %></p>
    <div class="today-stills" aria-hidden="true">
      <% @workout.exercises.uniq.first(6).each do |ex| %><%= still_tag ex, size: 144, alt: "" %><% end %>
    </div>
    <div class="row">
      <%= link_to (@done_today ? "Go again" : "Start"), play_workout_path(@workout), class: "btn btn-primary btn-big" %>
      <%= link_to "See details", workout_path(@workout), class: "btn" %>
    </div>
    <p class="muted small">
      <% if @from_routine %>
        Next in <%= link_to "your routine", routine_items_path %>. It moves on each time you finish one.
      <% else %>
        Picked for you: a different spice each time, starting with the ones you haven't done. Want your own rotation? <%= link_to "Build a routine", routine_items_path %>.
      <% end %>
    </p>
  </section>
<% end %>

<section class="card stack">
  <div class="spread">
    <h2>This week</h2>
    <span class="muted"><span class="num"><%= goal[:done_days] %></span> of <span class="num"><%= goal[:goal] %></span> days</span>
  </div>
  <div class="weekdots">
    <% week.each do |d| %>
      <div class="<%= "done" if d[:done] %> <%= "today" if d[:date] == today %>">
        <span><%= d[:date].strftime("%a")[0, 2] %></span><i aria-label="<%= d[:done] ? "done" : "not done" %>"><%= "✓" if d[:done] %></i>
      </div>
    <% end %>
  </div>
  <p class="muted small">
    <% if left <= 0 %>Weekly goal reached. <% else %><%= pluralize left, "more day" %> to reach your goal of <%= goal[:goal] %> workout days this week. <% end %>
    <%= link_to "Change goal", settings_path(anchor: "user_weekly_goal") %>
  </p>
  <p class="streak">
    <span class="big num"><%= @stats.current_streak %></span>
    <span class="muted">day streak<br><span class="small"><%= @fallen ? "七転び八起き. Fall seven times, get up eight: today starts a new one." : "Days in a row with a workout." %></span></span>
  </p>
</section>

<% if @god %>
  <%= link_to stats_path(anchor: "h-gods"), class: "card next-god" do %>
    <span class="medal" data-format="<%= @god[:format] %>" aria-hidden="true"><%= @god[:ja].first %></span>
    <span><span class="muted small">Next badge</span><br><strong><%= @god[:name] %> <%= @god[:ja] %></strong><br>
      <span class="muted small"><%= @god[:need].capitalize %>. <%= @god[:kind] == :total ? "You have #{@god[:progress]}." : "Your best so far: #{@god[:progress]}." %></span></span>
  <% end %>
<% end %>

<p class="muted">
  <% if @last_log %>Last workout: <%= link_to @last_log.workout_name, workout_log_path(@last_log) %>, <%= ago @last_log.performed_at %>.<% else %>No workouts yet. Your first seven minutes await.<% end %>
</p>

<h2>Something else?</h2>
<div class="grid">
  <% @picks.each do |label, workout| %><%= render "workouts/card", workout:, label: %><% end %>
</div>

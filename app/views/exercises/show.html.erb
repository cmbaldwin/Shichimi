<% ex = @exercise %>
<% content_for :title, "#{ex.name} · Shichimi" %>
<div class="ex-show">
  <div class="ex-media">
    <% if (video = File.exist?(Rails.public_path.join("videos/#{ex.slug}.mp4"))) %>
      <video class="ex-figure ex-video" src="/videos/<%= ex.slug %>.mp4" poster="/videos/<%= ex.slug %>.webp"
             autoplay muted loop playsinline preload="auto" aria-label="Video of a figure doing <%= ex.name %>"></video>
    <% end %>
    <canvas class="ex-figure" data-controller="figure" data-figure-motion-value="<%= motion_json(ex) %>"
            aria-label="Animated figure doing <%= ex.name %> (drag to rotate)" role="img"></canvas>
    <% if video %>
      <label class="ex-3d-toggle chip"><input type="checkbox"> Interactive 3D</label>
    <% end %>
  </div>
  <div class="stack">
    <div>
      <h1><%= ex.name %></h1>
      <% if ex.ja.present? %><p class="ja"><%= ex.ja %></p><% end %>
      <div class="row">
        <%= link_to ex.category, exercises_path(category: ex.category), class: "chip", data: { category: ex.category } %>
        <%= render "flags", exercise: ex %>
      </div>
    </div>
    <% if ex.muscles.present? %>
      <section><h2>Muscles</h2><p><%= Array(ex.muscles).join(", ") %></p></section>
    <% end %>
    <% if ex.cues.present? %>
      <section><h2>Cues</h2><ul class="ex-cues"><% Array(ex.cues).each do |c| %><li><%= c %></li><% end %></ul></section>
    <% end %>
    <% if (ref = ex.reference).present? %>
      <section class="ex-ref">
        <h2>See it done</h2>
        <ul>
          <% if ref["video_url"].present? %>
            <li>▶︎ <%= link_to ref["video_title"].presence || "Video demo", ref["video_url"], target: "_blank", rel: "noopener" %>
              <span class="muted">(YouTube<%= ", #{ref["video_channel"]}" if ref["video_channel"].present? %>)</span></li>
          <% end %>
          <% if ref["source_url"].present? %>
            <li>📖 <%= link_to "Form guide: #{ref["source_name"].presence || "reference"}", ref["source_url"], target: "_blank", rel: "noopener" %></li>
          <% end %>
        </ul>
      </section>
    <% end %>
    <% if ex.easier.present? || ex.harder.present? %>
      <section class="ex-variants">
        <% if ex.easier.present? %><div class="card"><h3>Easier</h3><p><%= ex.easier %></p></div><% end %>
        <% if ex.harder.present? %><div class="card"><h3>Harder</h3><p><%= ex.harder %></p></div><% end %>
      </section>
    <% end %>
  </div>
</div>

<section class="stack ex-section">
  <h2>Key frames</h2>
  <div class="ex-strip">
    <% ((Array(ex.motion["keys"]).presence || [ {} ]).size * (ex.motion["mirror"] ? 2 : 1)).times do |i| %>
      <%= thumb_tag ex, key: i, size: 200, alt: "Key frame #{i + 1}" %>
    <% end %>
  </div>
</section>

<% if @workouts.any? %>
  <section class="stack ex-section">
    <h2>In workouts</h2>
    <ul class="ex-workouts">
      <% @workouts.each do |w| %>
        <li><%= link_to w.name, workout_path(w) %> <span class="muted"><%= w.workout_format.name rescue w.format %></span></li>
      <% end %>
    </ul>
  </section>
<% end %>
<p><%= link_to "← All exercises", exercises_path %></p>

<% content_for :title, "Reset password · Shichimi" %>
<section class="auth card">
  <h1>Forgot your password?</h1>
  <%= form_with url: passwords_path, class: "stack" do |form| %>
    <%= form.label :email_address, "Email" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
  <% end %>
</section>

<!doctype html>
<html><head><meta charset="utf-8"><title><%= @exercise.name %> motion sheet</title>
<meta name="mannequin-model" content="<%= asset_path("mannequin.glb") %>">
<%= javascript_importmap_tags %>
<style>body{margin:8px;font:14px system-ui;background:#f7f2e9}h1{font-size:16px;margin:4px 0}
.row{display:grid;grid-template-columns:repeat(6,1fr);gap:4px;margin-bottom:8px}
figure{margin:0;background:#fff;border:1px solid #ddd}figure img{width:100%;display:block}figcaption{font-size:11px;padding:2px 4px}</style>
</head><body data-motion="<%= motion_json(@exercise) %>">
<h1><%= @exercise.name %> · tempo <%= @exercise.motion["tempo"] %>s · <%= Array(@exercise.motion["keys"]).size %> keys<%= " (+mirror)" if @exercise.motion["mirror"] %></h1>
<div id="sheet"></div>
<script type="module">
  import { renderThumbnail, modelReady } from "mannequin"
  await modelReady()
  const motion = JSON.parse(document.body.dataset.motion)
  const sheet = document.getElementById("sheet")
  for (const [label, turn] of [["view", 0], ["side (+90°)", 90]]) {
    const row = document.createElement("div"); row.className = "row"
    for (let i = 0; i < 12; i++) {
      const at = i / 12
      const f = document.createElement("figure")
      f.innerHTML = `<img src="${renderThumbnail(motion, { at, turn, width: 300, height: 300 })}"><figcaption>${label} t=${at.toFixed(2)}</figcaption>`
      row.append(f)
    }
    sheet.append(row)
  }
  document.body.dataset.ready = "1"
</script>
</body></html>
